# Copy: cp .env.example .env   (.env nằm trong .gitignore — KHÔNG commit)
# Không ghi secret thật vào file này.

# ── Server ──────────────────────────────
PORT=8000
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Security ────────────────────────────
# Tạo key mạnh: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# ── Storage ─────────────────────────────
# Trong docker compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Rate limit & cost guard ─────────────
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
